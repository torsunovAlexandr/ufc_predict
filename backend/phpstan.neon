# Статический анализ. Запускается локально командой `make analyse`
# и в сборке `backend` на каждый pull request.
#
# Уровень 6 выбран как рабочий максимум для кода без аннотаций-заглушек:
# он требует типы у всех параметров и возвращаемых значений, но не заставляет
# описывать каждый массив дженериком. С этапа 1, когда появится Domain
# без зависимостей, для него можно поднять уровень отдельной секцией.

includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6

    paths:
        - app
        - database
        - routes
        - tests

    # Файлы приложения, а не библиотеки: игнорировать нечего.
    ignoreErrors: []

    reportUnmatchedIgnoredErrors: true
