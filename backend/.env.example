# Образец окружения бекенда.
#
# Настоящий backend/.env создаётся командой `make setup` и в репозиторий не попадает.
# Генератор только ДОПИСЫВАЕТ недостающие ключи и никогда не перезаписывает
# существующие значения — см. дефект №7 в docs/roadmap-v2.md.
#
# Значения ниже — это то, что работает внутри docker-сети. Порт базы здесь 3306:
# это порт ВНУТРИ сети. Порт, по которому база видна с вашей машины (PhpStorm,
# TablePlus), задаётся отдельно ключом DB_PORT_EXTERNAL в КОРНЕВОМ .env.

APP_NAME="UFC Predict"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Имя хоста mysql — это имя сервиса в docker-compose.yml, а не адрес вашей машины.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ufc_predict
DB_USERNAME=ufc
DB_PASSWORD=secret

# Сессии в файлах: API не пользуется сессиями, отдельная таблица не нужна.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Кэш и очередь в базе: это единственное, ради чего на этапе 0 выполняются
# миграции, и заодно доказательство, что приложение действительно пишет в MySQL.
CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log

# Ключ The Odds API. Понадобится с этапа 4; до тех пор остаётся пустым.
# В CI берётся из Secrets репозитория, локально — из этого файла.
ODDS_API_KEY=
