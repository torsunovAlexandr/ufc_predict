APP_NAME="UFC Predict"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Moscow
APP_URL=http://localhost:8080
APP_LOCALE=ru

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- База данных ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ufc_predict
DB_USERNAME=ufc
DB_PASSWORD=secret

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=file

# --- CORS: адреса, с которых ходит фронтенд ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# --- The Odds API (https://the-odds-api.com) ---
# Бесплатный ключ даёт 500 запросов в месяц. Без ключа коэффициенты
# можно вводить вручную в интерфейсе.
ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
ODDS_API_SPORT=mma_mixed_martial_arts
ODDS_API_REGIONS=eu,uk
ODDS_API_DAILY_LIMIT=500

# Какой источник коэффициентов основной: the_odds_api | scraper | manual
ODDS_PROVIDER=the_odds_api

# --- Парсеры букмекеров (по умолчанию выключены, см. README) ---
SCRAPER_MARATHONBET_ENABLED=false
SCRAPER_1XBET_ENABLED=false

# --- Google Custom Search (поиск результатов боёв, 100 запросов/день) ---
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
GOOGLE_CSE_DAILY_LIMIT=100

# Наполнить базу демонстрационными данными при первом сиде
SEED_DEMO_DATA=true
