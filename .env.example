# Образец КОРНЕВОГО .env — того, который читает docker compose.
#
# Настоящий .env создаётся командой `make setup` и в репозиторий не попадает.
# Генератор только ДОПИСЫВАЕТ недостающие ключи и никогда не трогает уже
# записанные значения: однажды перезапись этого файла стёрла ручные настройки
# и сломала работающее подключение (дефекты №6 и №7 в docs/roadmap-v2.md).
#
# Не путайте с backend/.env: там параметры, которые видит приложение ВНУТРИ
# docker-сети. Здесь — параметры, которые видит ваша машина СНАРУЖИ.

# Порт, на котором приложение открывается в браузере: http://localhost:8080
APP_PORT=8080

# Порт, по которому база видна с вашей машины — из PhpStorm, TablePlus, mysql.
# 33061, а не 3306: 3306 обычно занят локально установленным MySQL.
# Записывается явным числом и после первой настройки не меняется.
DB_PORT_EXTERNAL=33061

# Должны совпадать с одноимёнными ключами в backend/.env — из них
# docker compose создаёт базу и пользователя при первом запуске.
DB_DATABASE=ufc_predict
DB_USERNAME=ufc
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# Порт vite в режиме разработки: http://localhost:5173
VITE_PORT=5173

# Режим Xdebug. Переключается командами `make debug-on` и `make debug-off`,
# руками сюда лезть не нужно.
XDEBUG_MODE=off
