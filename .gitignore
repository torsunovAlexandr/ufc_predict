# Корневой .env создаётся командой `make setup` и содержит пароль к базе —
# в репозиторий не попадает. Образец с описанием ключей — .env.example.
/.env

# Собранный фронтенд. В git его нет намеренно: собранные файлы рядом
# с исходниками приводят к тому, что рассинхрон сборки замечается поздно.
# Собирается командой `make front`.
/frontend/dist/

# Токен GitHub и прочие секреты — только на диске.
.secrets/

# Бекенд первой версии. Лежит на диске на случай, если из него
# понадобится что-то подсмотреть; в репозиторий не входит.
_to_delete/

.DS_Store
.idea/
.vscode/
