[mysqld]
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
max_connections = 100
innodb_buffer_pool_size = 256M

# ВНИМАНИЕ: не добавляйте сюда default-authentication-plugin.
# Эта переменная удалена в MySQL 8.4 (была объявлена устаревшей в 8.0.34).
# При её наличии сервер падает на старте с ошибкой
#   [ERROR] [MY-000067] [Server] unknown variable 'default-authentication-plugin=...'
# и контейнер уходит в бесконечный перезапуск.
# В 8.4 плагином по умолчанию и так является caching_sha2_password,
# а если понадобится его переопределить — переменная теперь называется
# authentication_policy.
